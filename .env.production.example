# Copy to .env.production on EC2; chmod 600. Never commit the completed file.
# Used for Compose interpolation AND app environment: --env-file .env.production.
COMPOSE_PROJECT_NAME=emergency-production
APP_IMAGE=emergency-backend
APP_TAG=latest
PUBLIC_HOST=emergency.example.com
HTTP_PORT=80
HTTPS_PORT=443
DJANGO_ENV=production
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=emergency.example.com
# Start with HTTP only for infrastructure verification, then enable HTTPS.
# Never send real credentials/contact/GPS/media over HTTP.
DJANGO_HTTPS_ENABLED=true
DJANGO_HSTS_SECONDS=3600
CSRF_TRUSTED_ORIGINS=https://emergency.example.com
# Same-origin UI requires no REST CORS. Only set exact additional REST origins.
CORS_ALLOWED_ORIGINS=
WS_ALLOWED_ORIGINS=https://emergency.example.com
POSTGRES_HOST=replace-with-private-rds-endpoint
POSTGRES_PORT=5432
POSTGRES_DB=emergency
POSTGRES_USER=emergency_app
POSTGRES_PASSWORD=replace-with-database-password
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/etc/emergency/certificates/rds-global-bundle.pem
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/2
REDIS_CHANNEL_PREFIX=emergency-production
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_TASK_DEFAULT_QUEUE=emergency-background
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=replace-with-private-bucket
# Use EC2 instance profile; omit all access-key/session-token variables.
AWS_EC2_METADATA_DISABLED=false
CLOUDWATCH_LOG_GROUP=/emergency/production
CLUSTER_RADIUS_METERS=300
CLUSTER_TIME_WINDOW_MINUTES=30
CLUSTER_MAX_CANDIDATES=50
DISPATCH_RADIUS_METERS=50000
DISPATCH_MAX_SUGGESTIONS=20
GPS_MIN_INTERVAL_SECONDS=5
GPS_MAX_AGE_SECONDS=120
GPS_FUTURE_TOLERANCE_SECONDS=30
MEDIA_MAX_BYTES=52428800
MEDIA_UPLOAD_TTL_SECONDS=300
MEDIA_DOWNLOAD_TTL_SECONDS=300
MEDIA_CLEANUP_GRACE_SECONDS=120
MEDIA_IMAGE_MAX_DIMENSION=1600
MEDIA_IMAGE_MAX_PIXELS=20000000
MEDIA_IMAGE_QUALITY=82
MEDIA_IMAGE_OUTPUT_FORMAT=JPEG
LEAFLET_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Switch provider through configuration; public Nominatim forbids autocomplete.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=EmergencyResponseSystem/1.0 (+https://vjettejv.id.vn/)
GEOCODER_CACHE_SECONDS=86400
INCIDENT_LOCATION_DISTANCE_WARNING_METERS=1000
CAMERA_VIDEO_MAX_SECONDS=30
