# Local development only. Copy to .env; replace both placeholders.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HTTPS_ENABLED=false
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
POSTGRES_DB=emergency
POSTGRES_USER=emergency
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_SSLROOTCERT=
# Host-side port only; containers still connect to db:5432.
POSTGRES_HOST_PORT=55432
# Potential duplicates are suggestions only; no automatic merge.
CLUSTER_RADIUS_METERS=300
CLUSTER_TIME_WINDOW_MINUTES=30
CLUSTER_MAX_CANDIDATES=50
DISPATCH_RADIUS_METERS=50000
DISPATCH_MAX_SUGGESTIONS=20
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/2
REDIS_CHANNEL_PREFIX=emergency
WS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
GPS_MIN_INTERVAL_SECONDS=5
GPS_MAX_AGE_SECONDS=120
GPS_FUTURE_TOLERANCE_SECONDS=30
# Optional tile provider (OSM-compatible raster URL). No tile prefetch/offline download.
LEAFLET_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Seed only: set temporarily when running manage.py seed_demo; never commit a password.
DEMO_PASSWORD=
# S3 stays private. Prefer IAM roles in deployment; never commit credentials.
S3_BUCKET_NAME=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Local Docker only; omit/disable this when using EC2 IAM role credentials.
AWS_EC2_METADATA_DISABLED=true
MEDIA_MAX_BYTES=52428800
MEDIA_UPLOAD_TTL_SECONDS=300
MEDIA_DOWNLOAD_TTL_SECONDS=300
MEDIA_CLEANUP_GRACE_SECONDS=120
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_TASK_DEFAULT_QUEUE=emergency-background
# Production uses .env.production.example and compose.production.yaml;
# POSTGRES_* are the project's equivalents of DATABASE_*; S3_BUCKET_NAME is
# the existing equivalent of AWS_S3_BUCKET_NAME. Do not set two conflicting names.
